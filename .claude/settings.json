{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(pnpm:*)",
      "Bash(source:*)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "docker",
      "docker-compose"
    ],
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "github.com",
        "*.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "sonarcloud.io",
        "*.sonarcloud.io",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com"
      ]
    }
  }
}
