{
  "name": "servicedesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Service desk interno MCP-first — arquitetura hexagonal, TypeScript ponta-a-ponta",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "commitlint": "commitlint",
    "db:migrate": "psql \"$DATABASE_URL\" -f drizzle/migrations/0001_inicial.sql"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  }
}
