{
  "name": "servicedesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Service desk interno MCP-first — arquitetura hexagonal, TypeScript ponta-a-ponta",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "minimist": "1.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
