{
  "name": "servicedesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Service desk interno MCP-first — arquitetura hexagonal, TypeScript ponta-a-ponta",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "build": "tsc -p tsconfig.build.json",
    "commitlint": "commitlint",
    "db:migrate": "for f in drizzle/migrations/*.sql; do echo \"-> $f\"; psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "format": "biome format --write .",
    "lint": "biome ci .",
    "start": "node dist/src/bootstrap/servidor-mcp.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "0.45.2",
    "imapflow": "^1.6.6",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.1"
    }
  }
}
